# Sao chép file này thành .env rồi sửa (hoặc đặt biến môi trường trực tiếp)
# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ADMIN_PASSWORD=
DATABASE_URL=sqlite:///./firefly.db
FRONTEND_ORIGIN=http://localhost:5173
# T19: thư mục poster (tương đối từ backend hoặc đường dẫn tuyệt đối).
UPLOAD_DIR=uploads

# VietQR. Để trống bất kỳ giá trị nào thì vé không có ảnh QR.
BANK_ID=970436
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=

# Thư mục chứa model PhoBERT đã train
MODEL_DIR=models/phobert-binhluan
MODEL_DIR_B=models/phobert-binhluan-B
MODEL_VERSION_A=A-backend
MODEL_VERSION_B=phobert-B-2026-10-09
# Chỉ số nhãn "tiêu cực" trong model của bạn (xem id2label trong config.json của model)
NEGATIVE_LABEL_ID=1
# Model A dùng text_norm nhưng không tách từ
USE_WORD_SEGMENT=false
USE_TEXT_NORM=true
NEGATIVE_THRESHOLD=0.5
# Model dùng để chấm và lưu bình luận mới. Không có giao diện đổi giá trị này.
ACTIVE_MODEL=phobert_b
# Đường dẫn tương đối tính từ thư mục backend; bỏ mục không muốn nạp.
SKLEARN_MODELS=svm:../ml/artifacts/baselines/svm_A.joblib,lr:../ml/artifacts/baselines/lr_A.joblib,nb:../ml/artifacts/baselines/nb_A.joblib

# T17 chat (tuỳ chọn). Không commit CHAT_API_KEY thật.
CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CHAT_API_KEY=
CHAT_MODEL=gemini-3.5-flash-lite
CHAT_RATE_PER_MINUTE=5
CHAT_RATE_PER_DAY=50
