# Sao chép file này thành .env rồi sửa (hoặc đặt biến môi trường trực tiếp)
SECRET_KEY=doi-chuoi-bi-mat-nay
DATABASE_URL=sqlite:///./firefly.db
FRONTEND_ORIGIN=http://localhost:5173

# Thư mục chứa model PhoBERT đã train
MODEL_DIR=models/phobert-binhluan
# Chỉ số nhãn "tiêu cực" trong model của bạn (xem id2label trong config.json của model)
NEGATIVE_LABEL_ID=1
# Model A dùng text_norm nhưng không tách từ
USE_WORD_SEGMENT=false
USE_TEXT_NORM=true
NEGATIVE_THRESHOLD=0.5
